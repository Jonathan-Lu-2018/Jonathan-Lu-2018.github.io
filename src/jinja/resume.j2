<article class="resume" data-page="resume">
  <header>
    <h2 class="h2 article-title">{{resume.HEADER.label}}</h2>
  </header>

  <!-- EDUCATION -->
  {% if resume.EDUCATION.enabled %}
  <section class="timeline">
    <div class="title-wrapper">
      <div class="icon-box">
        <ion-icon name="book-outline"></ion-icon>
      </div>
      <h3 class="h3">{{resume.EDUCATION.label}}</h3>
    </div>
    <ol class="timeline-list">
      {% for item in resume.EDUCATION["items"] | reverse %}
      <li class="timeline-item">
        <div class="timeline-item-content">
          <h4 class="h4 timeline-item-title">
            {% if item.logo %}
            <img src="{{item.logo}}" alt="School logo" class="position-logo">
            {% endif %}
            {{item.institution}}
          </h4>
        <span>{{item.period}}</span>
        {% if item.description %}
        <div class="timeline-text">
          {% if item.description is string %}
            {% for line in item.description.split('\n') %}
              {% if line.strip() %}
              <p>{{ line.strip() }}</p>
              {% endif %}
            {% endfor %}
          {% else %}
            {% for point in item.description %}
            <p>{{ point }}</p>
            {% endfor %}
          {% endif %}
        </div>
        {% endif %}
        {% if item.coursework %}
        <div class="coursework">
          <h5 class="coursework-title">📚 Coursework</h5>
          <ul class="coursework-list">
            {% for course in item.coursework %}
            <li class="coursework-item">{{ course }}</li>
            {% endfor %}
          </ul>
        </div>
        {% endif %}
        </div>
      </li>
      {% endfor %}
    </ol>
  </section>
  {% endif %}

  <!-- EXPERIENCE -->
  {% if resume.EXPERIENCE.enabled %}
  <section class="timeline">
    <div class="title-wrapper">
      <div class="icon-box">
        <ion-icon name="book-outline"></ion-icon>
      </div>
      <h3 class="h3">{{resume.EXPERIENCE.label}}</h3>
    </div>

    <ol class="timeline-list">
      {% for item in resume.EXPERIENCE["items"] | reverse %}
      <li class="timeline-item">
        <h4 class="h4 timeline-item-title">{{item.position}}</h4>
        <span>{{item.period}}</span>
        <p class="timeline-text">
          {{item.description}}
        </p>
      </li>
      {% endfor %}
    </ol>
  </section>
  {% endif %}
</article>